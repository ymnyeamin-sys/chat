import { validateRegisterPayload, validateLoginPayload, validateMessagePayload, sanitizeText } from '../../shared/validation.js';
import { hashPassword, verifyPassword } from './auth.js';
import { AUTH_COOKIE_NAME, getCorsHeaders, SESSION_TTL_MS } from './config.js';
import { getDb, nowISO, randomId } from './db.js';

const JSON_HEADERS = {
  'content-type': 'application/json;charset=UTF-8'
};

function jsonResponse(data, status = 200, extraHeaders = {}) {
  return new Response(JSON.stringify(data), {
    status,
    headers: { ...JSON_HEADERS, ...getCorsHeaders(), ...extraHeaders }
  });
}

function parseJson(req) {
  return req.headers.get('content-type')?.includes('application/json')
    ? req.json()
    : Promise.resolve({});
}

function getCookie(headers, name) {
  const cookieHeader = headers.get('Cookie') || headers.get('cookie') || '';
  const match = cookieHeader.split('; ').find((pair) => pair.startsWith(`${name}=`));
  if (!match) return null;
  return decodeURIComponent(match.split('=').slice(1).join('='));
}

async function getCurrentUser(req, env) {
  const sessionToken = getCookie(req.headers, AUTH_COOKIE_NAME);
  if (!sessionToken) return null;

  const db = getDb(env);
  const row = await db.prepare(`
    SELECT u.*
    FROM sessions s
    JOIN users u ON s.user_id = u.id
    WHERE s.session_token = ? AND s.expires_at > ?
  `).bind(sessionToken, nowISO()).first();

  return row;
}

async function ensureAuthorizedForConversation(user, conversationId, env) {
  const db = getDb(env);
  const row = await db.prepare(`
    SELECT 1
    FROM conversation_members
    WHERE conversation_id = ? AND user_id = ?
  `).bind(conversationId, user.id).first();

  if (!row) {
    throw new Error('You are not a member of this conversation');
  }
  return true;
}

async function persistMessage(env, conversationId, senderId, content, replyTo = null) {
  const db = getDb(env);
  const id = randomId('msg');
  await db.prepare(`
    INSERT INTO messages (id, conversation_id, sender_id, content, reply_to, created_at)
    VALUES (?, ?, ?, ?, ?, ?)
  `).bind(id, conversationId, senderId, content, replyTo, nowISO()).run();

  await db.prepare(`
    UPDATE conversations
    SET last_message_id = ?, updated_at = ?
    WHERE id = ?
  `).bind(id, nowISO(), conversationId).run();

  return { id, conversation_id: conversationId, sender_id: senderId, content, reply_to: replyTo, created_at: nowISO() };
}

export class ChatRoom extends DurableObject {
  constructor(state, env) {
    super(state, env);
    this.sessions = new Map();
  }

  async fetch(request) {
    const url = new URL(request.url);

    if (url.pathname === '/emit') {
      const payload = await request.json();
      for (const socket of this.sessions.values()) {
        if (socket.readyState === WebSocket.OPEN) {
          socket.send(JSON.stringify(payload));
        }
      }
      return jsonResponse({ ok: true }, 200);
    }

    if (request.headers.get('Upgrade') !== 'websocket') {
      return new Response('Expected WebSocket', { status: 400 });
    }

    const [client, server] = Object.values(new WebSocketPair());
    const userId = url.searchParams.get('userId');
    const conversationId = url.searchParams.get('conversationId');

    if (!userId || !conversationId) {
      client.close();
      return new Response('Missing user or conversation data', { status: 400 });
    }

    this.sessions.set(userId, server);
    server.accept();

    server.addEventListener('message', (event) => {
      const msg = JSON.parse(event.data);
      if (msg.type === 'typing') {
        for (const socket of this.sessions.values()) {
          if (socket !== server && socket.readyState === WebSocket.OPEN) {
            socket.send(JSON.stringify({ type: 'typing', userId, conversationId, isTyping: msg.isTyping }));
          }
        }
      }

      if (msg.type === 'signal') {
        const targetUserId = msg.targetUserId;
        const targetSocket = this.sessions.get(targetUserId);
        if (targetSocket && targetSocket.readyState === WebSocket.OPEN) {
          targetSocket.send(JSON.stringify({ type: 'signal', sourceUserId: userId, payload: msg.payload }));
        }
      }
    });

    server.addEventListener('close', () => {
      this.sessions.delete(userId);
    });

    return new Response(null, {
      status: 101,
      webSocket: client
    });
  }
}

export default {
  async fetch(request, env, ctx) {
    if (request.method === 'OPTIONS') {
      return new Response(null, {
        headers: getCorsHeaders(request.headers.get('Origin') || '*')
      });
    }

    const url = new URL(request.url);

    if (url.pathname === '/health') {
      return jsonResponse({ ok: true, service: 'bondhuchat-worker' }, 200);
    }

    if (url.pathname === '/ws') {
      const sessionToken = getCookie(request.headers, AUTH_COOKIE_NAME);
      if (!sessionToken) {
        return jsonResponse({ error: 'Unauthorized' }, 401);
      }

      const user = await getCurrentUser(request, env);
      if (!user) {
        return jsonResponse({ error: 'Invalid session' }, 401);
      }

      const conversationId = url.searchParams.get('conversationId');
      if (!conversationId) {
        return jsonResponse({ error: 'Conversation is required' }, 400);
      }

      const db = getDb(env);
      const membership = await db.prepare(`
        SELECT 1 FROM conversation_members WHERE conversation_id = ? AND user_id = ?
      `).bind(conversationId, user.id).first();

      if (!membership) {
        return jsonResponse({ error: 'Not a member of this conversation' }, 403);
      }

      const room = env.CHAT_ROOM.get(env.CHAT_ROOM.idFromName(`conv-${conversationId}`));
      return room.fetch(new Request(`${url.origin}/ws?conversationId=${conversationId}&userId=${user.id}`, {
        headers: request.headers,
        method: 'GET'
      }));
    }

    if (url.pathname === '/api/v1/me') {
      const user = await getCurrentUser(request, env);
      if (!user) {
        return jsonResponse({ error: 'Unauthorized' }, 401);
      }
      return jsonResponse({
        id: user.id,
        username: user.username,
        email: user.email,
        fullName: user.full_name,
        avatarUrl: user.avatar_url,
        bio: user.bio,
        lastSeen: user.last_seen
      });
    }

    if (url.pathname === '/api/v1/register' && request.method === 'POST') {
      const payload = await parseJson(request);
      const validation = validateRegisterPayload(payload);
      if (!validation.ok) {
        return jsonResponse({ error: validation.error }, 400);
      }

      const db = getDb(env);
      const existing = await db.prepare('SELECT id FROM users WHERE username = ? OR email = ?').bind(validation.value.username, validation.value.email).first();
      if (existing) {
        return jsonResponse({ error: 'A user with that username or email already exists' }, 409);
      }

      const passwordHash = await hashPassword(validation.value.password);
      const userId = randomId('user');
      await db.prepare(`
        INSERT INTO users (id, username, email, password_hash, full_name, created_at, updated_at, last_seen)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
      `).bind(userId, validation.value.username, validation.value.email, passwordHash, sanitizeText(payload.fullName || validation.value.username, 120), nowISO(), nowISO(), nowISO()).run();

      return jsonResponse({ ok: true, message: 'Account created' }, 201);
    }

    if (url.pathname === '/api/v1/login' && request.method === 'POST') {
      const payload = await parseJson(request);
      const validation = validateLoginPayload(payload);
      if (!validation.ok) {
        return jsonResponse({ error: validation.error }, 400);
      }

      const db = getDb(env);
      const user = await db.prepare('SELECT * FROM users WHERE username = ?').bind(validation.value.username).first();
      if (!user) {
        return jsonResponse({ error: 'Invalid username or password' }, 401);
      }

      const valid = await verifyPassword(validation.value.password, user.password_hash);
      if (!valid) {
        return jsonResponse({ error: 'Invalid username or password' }, 401);
      }

      const sessionToken = randomId('sess');
      const expiresAt = new Date(Date.now() + SESSION_TTL_MS).toISOString();
      await db.prepare(`
        INSERT INTO sessions (id, user_id, session_token, expires_at, created_at, updated_at)
        VALUES (?, ?, ?, ?, ?, ?)
      `).bind(randomId('session'), user.id, sessionToken, expiresAt, nowISO(), nowISO()).run();

      return new Response(JSON.stringify({ ok: true, user: { id: user.id, username: user.username } }), {
        status: 200,
        headers: {
          ...JSON_HEADERS,
          ...getCorsHeaders(request.headers.get('Origin') || '*'),
          'Set-Cookie': `${AUTH_COOKIE_NAME}=${sessionToken}; HttpOnly; Path=/; SameSite=Lax; Secure; Max-Age=604800`
        }
      });
    }

    if (url.pathname === '/api/v1/logout' && request.method === 'POST') {
      const user = await getCurrentUser(request, env);
      if (!user) {
        return jsonResponse({ error: 'Not logged in' }, 401);
      }
      const db = getDb(env);
      const token = getCookie(request.headers, AUTH_COOKIE_NAME);
      await db.prepare('DELETE FROM sessions WHERE session_token = ?').bind(token).run();
      return new Response(JSON.stringify({ ok: true }), {
        status: 200,
        headers: {
          ...JSON_HEADERS,
          ...getCorsHeaders(request.headers.get('Origin') || '*'),
          'Set-Cookie': `${AUTH_COOKIE_NAME}=; HttpOnly; Path=/; SameSite=Lax; Max-Age=0; Secure`
        }
      });
    }

    const user = await getCurrentUser(request, env);
    if (!user) {
      return jsonResponse({ error: 'Unauthorized' }, 401);
    }

    if (url.pathname === '/api/v1/users/search') {
      const query = url.searchParams.get('q') || '';
      const db = getDb(env);
      const rows = await db.prepare(`
        SELECT id, username, full_name, avatar_url, bio FROM users
        WHERE username LIKE ? OR full_name LIKE ?
        LIMIT 10
      `).bind(`%${query}%`, `%${query}%`).all();
      return jsonResponse({ items: rows.results || [] });
    }

    if (url.pathname === '/api/v1/conversations' && request.method === 'GET') {
      const db = getDb(env);
      const rows = await db.prepare(`
        SELECT c.id, c.type, c.updated_at,
          CASE WHEN c.type = 'direct' THEN u.username ELSE c.name END AS display_name,
          m.content AS last_message
        FROM conversation_members cm
        JOIN conversations c ON c.id = cm.conversation_id
        LEFT JOIN messages m ON m.id = c.last_message_id
        LEFT JOIN conversation_members other ON other.conversation_id = c.id AND other.user_id != ?
        LEFT JOIN users u ON u.id = other.user_id
        WHERE cm.user_id = ?
        ORDER BY c.updated_at DESC
      `).bind(user.id, user.id).all();
      return jsonResponse({ items: rows.results || [] });
    }

    if (url.pathname === '/api/v1/conversations' && request.method === 'POST') {
      const payload = await parseJson(request);
      const targetUsername = sanitizeText(payload.targetUsername || '', 24);
      if (!targetUsername) {
        return jsonResponse({ error: 'A target username is required' }, 400);
      }

      const db = getDb(env);
      const targetUser = await db.prepare('SELECT * FROM users WHERE username = ?').bind(targetUsername).first();
      if (!targetUser) {
        return jsonResponse({ error: 'User not found' }, 404);
      }

      const existing = await db.prepare(`
        SELECT c.id
        FROM conversations c
        JOIN conversation_members cm1 ON cm1.conversation_id = c.id AND cm1.user_id = ?
        JOIN conversation_members cm2 ON cm2.conversation_id = c.id AND cm2.user_id = ?
        WHERE c.type = 'direct'
        LIMIT 1
      `).bind(user.id, targetUser.id).first();

      if (existing) {
        return jsonResponse({ id: existing.id, displayName: targetUser.username }, 200);
      }

      const conversationId = randomId('conversation');
      await db.prepare(`
        INSERT INTO conversations (id, name, type, created_by, created_at, updated_at)
        VALUES (?, ?, 'direct', ?, ?, ?)
      `).bind(conversationId, `${user.username}-${targetUser.username}`, user.id, nowISO(), nowISO()).run();

      await db.prepare(`
        INSERT INTO conversation_members (id, conversation_id, user_id, joined_at)
        VALUES (?, ?, ?, ?), (?, ?, ?, ?)
      `).bind(randomId('member'), conversationId, user.id, nowISO(), randomId('member'), conversationId, targetUser.id, nowISO()).run();

      return jsonResponse({ id: conversationId, displayName: targetUser.username }, 201);
    }

    const conversationMatch = url.pathname.match(/^\/api\/v1\/conversations\/([^/]+)\/messages$/);
    if (conversationMatch && request.method === 'GET') {
      const conversationId = conversationMatch[1];
      await ensureAuthorizedForConversation(user, conversationId, env);
      const db = getDb(env);
      const rows = await db.prepare(`
        SELECT m.*, u.username AS sender_name
        FROM messages m
        JOIN users u ON u.id = m.sender_id
        WHERE m.conversation_id = ? AND m.deleted_at IS NULL
        ORDER BY m.created_at ASC
        LIMIT 200
      `).bind(conversationId).all();
      return jsonResponse({ items: rows.results || [] });
    }

    if (conversationMatch && request.method === 'POST') {
      const conversationId = conversationMatch[1];
      await ensureAuthorizedForConversation(user, conversationId, env);
      const payload = await parseJson(request);
      const validation = validateMessagePayload(payload);
      if (!validation.ok) {
        return jsonResponse({ error: validation.error }, 400);
      }

      const message = await persistMessage(env, conversationId, user.id, validation.value.content);

      const room = env.CHAT_ROOM.get(env.CHAT_ROOM.idFromName(`conv-${conversationId}`));
      await room.fetch(new Request(`${url.origin}/emit`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ type: 'message', message: { ...message, senderId: user.id, conversationId } })
      }));

      return jsonResponse({ ok: true, message }, 201);
    }

    if (url.pathname === '/api/v1/calls/invite' && request.method === 'POST') {
      const payload = await parseJson(request);
      const targetUserId = String(payload.targetUserId || '');
      if (!targetUserId) {
        return jsonResponse({ error: 'Target user is required' }, 400);
      }

      const db = getDb(env);
      const target = await db.prepare('SELECT id, username FROM users WHERE id = ?').bind(targetUserId).first();
      if (!target) {
        return jsonResponse({ error: 'Target user does not exist' }, 404);
      }

      const callId = randomId('call');
      await db.prepare(`
        INSERT INTO call_history (id, caller_id, callee_id, kind, status, created_at)
        VALUES (?, ?, ?, ?, ?, ?)
      `).bind(callId, user.id, targetUserId, payload.kind || 'audio', 'ringing', nowISO()).run();

      return jsonResponse({ ok: true, callId, targetUserId, kind: payload.kind || 'audio' });
    }

    return jsonResponse({ error: 'Not found' }, 404);
  }
};
